  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\nThe Woodman was in despair. \nThe axe was all he possessed with which
    to make a living, and he had not money enough to buy a new one. \nAs he stood
    wringing his hands and weeping, the Lady of the Lake suddenly appeared and asked
    what the trouble was. \nThe Woodman told what had happened, and straightway the
    kind lady dived into the pool. \nWhen she came up again, she held a wonderful
    golden axe.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 82124e3c1e7ab97409b092159f8bb787, type: 2}
  m_sharedMaterial: {fileID: 1053693477090562419, guid: 82124e3c1e7ab97409b092159f8bb787, type: 2}
