  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\nAnd indeed, the lady did appear, first to this one, then to that.\nTo
    each one she showed an axe of gold, and each one eagerly claimed it to be the
    one he had lost. \nBut she did not give them the golden axe. Oh no! Instead,
    she gave them each a hard whack over \nthe head and sent them home. \nAnd when
    they returned next day to look for their own axes, they were nowhere to be found."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 82124e3c1e7ab97409b092159f8bb787, type: 2}
  m_sharedMaterial: {fileID: 1053693477090562419, guid: 82124e3c1e7ab97409b092159f8bb787, type: 2}
