    - target: {fileID: 9104969418354573073, guid: 2ca2fecaeea37264d81d68052e74ba63, type: 3}
      propertyPath: m_text
      value: "\n\n\nThe Hare was soon far out of sight, and to make the Tortoise
        feel very deeply \nhow ridiculous it was for him to try a race with a Hare,
        he lay down beside \nthe course to take a nap until the Tortoise should catch
        up.\r\n\r"
      objectReference: {fileID: 0}
