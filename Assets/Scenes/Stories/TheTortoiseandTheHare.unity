    - target: {fileID: 9104969418354573073, guid: 2ca2fecaeea37264d81d68052e74ba63, type: 3}
      propertyPath: m_text
      value: "\n\n\n\n\n\n\nThe Hare was much amused at the idea of running a race
        with the \nTortoise, but for the fun of the thing he agreed. So, the Fox,
        who had consented to act as judge, \nmarked the distance and started the
        runners off.\r\n\n\r\n\r\n\n\r"
